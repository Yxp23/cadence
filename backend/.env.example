# Deepgram — streaming speech-to-text (https://deepgram.com)
DEEPGRAM_API_KEY=

# Anthropic — Claude powers the Tiles, Suggester, and Generator agents
ANTHROPIC_API_KEY=

# ElevenLabs — text-to-speech with emotion-tuned voice cloning
ELEVENLABS_API_KEY=

# Optional: override the default ElevenLabs voice (stock "Rachel")
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional: Redis URL for persistent conversation memory, vocab, and voice storage
# Leave blank to run without persistence (all features still work in-memory per session)
REDIS_URL=
